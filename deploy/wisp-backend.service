[Unit]
Description=WISP Backend (TUXTELL.NET)
After=network.target postgresql.service

[Service]
User=root
WorkingDirectory=/opt/wisp-backend
ExecStart=/opt/wisp-backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
EnvironmentFile=/opt/wisp-backend/.env

[Install]
WantedBy=multi-user.target
