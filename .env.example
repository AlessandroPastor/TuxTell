# ─── BASE DE DATOS ────────────────────────────────────────────────
# LOCAL (SQLite - para desarrollo)
DATABASE_URL=sqlite:///./tuxtell.db
# PRODUCCION VPS (descomentar en el VPS)
# DATABASE_URL=postgresql://tuxtell:tuxtell123@localhost:5432/tuxtelldb

# ─── SEGURIDAD JWT ────────────────────────────────────────────────
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_secreta_muy_larga_y_random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── SERVIDOR ─────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─── ALMACENAMIENTO DE COMPROBANTES ───────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/opt/wisp-backend/uploads

# ─── WHATSAPP (opcional) ──────────────────────────────────────────
WHATSAPP_PROVIDER=evolution
WHATSAPP_INSTANCE_URL=http://localhost:8080
WHATSAPP_API_KEY=

# ─── IPs DE MIKROTIK (WireGuard) ──────────────────────────────────
# NO van aquí. Se guardan en la tabla `bases` de la DB.
# VPS (servidor WireGuard): 10.10.0.1
# Cabanillas (peer WireGuard): 10.10.0.2  puerto RouterOS API: 8728
# Palca      (peer WireGuard): 10.10.0.3  puerto RouterOS API: 8728
# Paratia    (peer WireGuard): 10.10.0.4  puerto RouterOS API: 8728
# Configura con: PUT /bases/{id}  campo: ip_vpn
